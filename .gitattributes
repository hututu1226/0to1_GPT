# 统一换行与文本处理
* text=auto eol=lf

*.md      text eol=lf
*.py      text eol=lf
*.txt     text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
# notebook 是 JSON，Jupyter 自己写 LF，这里统一掉避免 diff 噪音
*.ipynb   text eol=lf

# Windows 脚本保留 CRLF
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# 二进制
*.pt        binary
*.pth       binary
*.ckpt      binary
*.safetensors binary
*.png       binary
*.jpg       binary
